{
  "id": "ecommerce-ad",
  "name": "电商广告",
  "enabled": true,
  "version": 1,
  "description": "根据商品与卖点动态规划广告镜头，生成商品锚点、广告画面、视频片段、配音并自动合成。",
  "category": "ecommerce",
  "aliases": ["电商广告", "商品广告", "带货广告", "ecommerce ad"],
  "triggers": {
    "keywords": ["电商广告", "商品广告", "带货视频", "产品广告", "商品宣传片"],
    "node_scopes": ["textGeneration", "imageGeneration", "videoGeneration", "audioGeneration"]
  },
  "planning": {
    "planning_notes": "根据用户目标动态确定镜头数量；没有商品图时先生成商品锚点，有商品图时把它作为一致性参考。",
    "prompt_guide": "突出商品卖点、使用场景、品牌调性和明确行动引导，所有镜头保持商品外观一致。"
  },
  "workflow_templates": [
    {
      "id": "ecommerce-ad-dynamic",
      "name": "动态电商广告",
      "description": "卖点策略、脚本、商品锚点、多镜头画面、视频、配音与合成。",
      "steps": [
        {
          "id": "ad-strategy",
          "step_number": 1,
          "goal_template": "提炼商品卖点、受众、平台和广告创意策略",
          "node_type": "textGeneration",
          "action_key": "general-text",
          "prompt_strategy": "user_message",
          "input_strategy": {"type": "none"},
          "multiplicity": "single"
        },
        {
          "id": "ad-script",
          "step_number": 2,
          "goal_template": "生成逐镜头电商广告脚本",
          "node_type": "textGeneration",
          "action_key": "video-storyboard-script",
          "prompt_strategy": "llm_refine",
          "input_strategy": {"type": "previous_step", "step_id": "ad-strategy"},
          "multiplicity": "single"
        },
        {
          "id": "product-anchor",
          "step_number": 3,
          "goal_template": "建立统一的商品视觉锚点",
          "node_type": "imageGeneration",
          "action_key": "general-image",
          "prompt_strategy": "llm_refine",
          "input_strategy": {"type": "previous_step_and_user_assets", "step_id": "ad-script"},
          "multiplicity": "single"
        },
        {
          "id": "ad-frames",
          "step_number": 4,
          "goal_template": "生成广告镜头关键画面",
          "node_type": "imageGeneration",
          "action_key": "ecommerce-ad-image",
          "prompt_strategy": "llm_refine",
          "input_strategy": {"type": "previous_step", "step_id": "product-anchor"},
          "multiplicity": "per_plan_item"
        },
        {
          "id": "ad-clips",
          "step_number": 5,
          "goal_template": "逐镜头生成广告视频片段",
          "node_type": "videoGeneration",
          "action_key": "video-clip-generation",
          "prompt_strategy": "llm_refine",
          "input_strategy": {"type": "previous_step", "step_id": "ad-frames"},
          "multiplicity": "per_input"
        },
        {
          "id": "ad-audio",
          "step_number": 6,
          "goal_template": "生成广告旁白、音乐与音效方案",
          "node_type": "audioGeneration",
          "action_key": "general-audio",
          "prompt_strategy": "llm_refine",
          "input_strategy": {"type": "previous_step", "step_id": "ad-script"},
          "multiplicity": "single"
        }
      ]
    }
  ]
}
