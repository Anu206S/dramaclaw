{
  "id": "image-to-text",
  "enabled": true,
  "version": 1,
  "description": "图生文工作流：图片输入 -> 文本生成。",
  "category": "basic",
  "aliases": ["image_to_text", "img2text", "i2t", "图生文", "图片生成文本"],
  "triggers": {
    "keywords": ["图生文", "图片生成文本", "图片分析", "图片转文字", "image to text"]
  },
  "planning": {
    "planning_notes": "创建图片输入节点和文本生成节点，并按顺序连接。",
    "prompt_guide": "文本节点根据上游图片生成描述、提示词、文案或分析文本。"
  },
  "workflow_templates": [
    {
      "id": "image-to-text",
      "description": "根据图片生成文本描述或分析。",
      "aliases": ["image_to_text", "img2text", "i2t", "图生文", "图片生成文本"],
      "condition": {
        "hasInputTypes": ["image"],
        "message_keywords": ["图生文", "图片生成文本", "图片分析"]
      },
      "steps": [
        {
          "id": "image_input",
          "step_number": 1,
          "goal_template": "图片输入",
          "node_type": "imageGeneration",
          "action_key": "general-image",
          "prompt_strategy": "user_message",
          "input_strategy": {"type": "user_assets", "filter": "image"},
          "need_review": false,
          "multiplicity": "single"
        },
        {
          "id": "text_output",
          "step_number": 2,
          "goal_template": "生成文本",
          "node_type": "textGeneration",
          "action_key": "general-text",
          "prompt_strategy": "llm_refine",
          "input_strategy": {"type": "previous_step", "step_id": "image_input"},
          "need_review": false,
          "multiplicity": "single"
        }
      ]
    }
  ]
}
