        {"id": "visual_style", "step_number": 3, "goal_template": "视觉风格", "node_type": "textGeneration", "action_key": "general-text", "prompt_strategy": "llm_refine", "input_strategy": {"type": "previous_step", "step_id": "song_input"}, "need_review": false, "multiplicity": "single"},
