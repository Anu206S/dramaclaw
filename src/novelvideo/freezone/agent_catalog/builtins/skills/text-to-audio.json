{
  "id": "text-to-audio",
  "enabled": true,
  "version": 1,
  "description": "文生音频工作流：音频文本 -> 音频生成。",
  "category": "basic",
  "aliases": ["text_to_audio", "txt2audio", "t2a", "文生音频", "文本生成音频"],
  "triggers": {
    "keywords": ["文生音频", "文本生成音频", "口播", "旁白", "配音", "TTS", "text to audio"]
  },
  "planning": {
    "planning_notes": "创建音频文本节点和音频生成节点，并按顺序连接。",
    "prompt_guide": "文本节点输入口播、对白、旁白或音频生成文本；音频节点根据上游文本生成音频。"
  },
  "workflow_templates": [
    {
      "id": "text-to-audio",
      "description": "根据文本生成音频。",
      "aliases": ["text_to_audio", "txt2audio", "t2a", "文生音频", "文本生成音频"],
      "condition": {
        "text_only": true,
        "message_keywords": ["文生音频", "文本生成音频", "口播", "旁白", "配音"]
      },
      "steps": [
        {
          "id": "text_prompt",
          "step_number": 1,
          "goal_template": "音频文本",
          "node_type": "textGeneration",
          "action_key": "general-text",
          "prompt_strategy": "user_message",
          "input_strategy": {"type": "none"},
          "need_review": false,
          "multiplicity": "single"
        },
        {
          "id": "audio_output",
          "step_number": 2,
          "goal_template": "生成音频",
          "node_type": "audioGeneration",
          "action_key": "general-text",
          "prompt_strategy": "llm_refine",
          "input_strategy": {"type": "previous_step", "step_id": "text_prompt"},
          "need_review": false,
          "multiplicity": "single"
        }
      ]
    }
  ]
}
